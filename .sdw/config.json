{
  "$schema": "./config.schema.json",
  "specsDir": "{projectRoot}/.sdw/specs",
  "scoreMin": 8,
  "scoring": {
    "judgeCommand": null,
    "judgeModel": null,
    "judgeProvider": null,
    "judgeEffort": null,
    "judgeApiEndpoint": null,
    "judgeCriticity": "strict"
  },
  "scmCodeReviewEnabled": true,
  "pushDelivery": true,
  "automation": {
    "autoShip": true,
    "autoMerge": true
  },
  "changelogEnabled": true,
  "changelogFile": "{projectRoot}/CHANGELOG.md",
  "stateDir": "{projectRoot}/.sdw/state",
  "sandboxDir": "{projectRoot}/.sdw/sandbox",
  "skillsRoot": "{projectRoot}/.agents/skills",
  "autoResolveGaps": true,
  "securityChecksEnabled": true,
  "useWorktrees": false,
  "useFeatureBranches": true,
  "branching": {
    "strategy": "gitflow",
    "featurePrefix": "feature/",
    "workBranch": "develop",
    "integrationBranch": "develop",
    "updateWorkBranch": true,
    "syncWorkBranchAfterMerge": true,
    "pushSyncedWorkBranch": false
  },
  "scmProvider": "github",
  "implementation": {
    "mode": "subagent",
    "command": null,
    "timeoutMs": 1800000,
    "envAllowlist": [
      "PATH",
      "HOME",
      "USERPROFILE",
      "TEMP",
      "TMP",
      "LANG",
      "LC_ALL"
    ]
  },
  "verification": {
    "buildCommand": "npm run build",
    "testCommand": "npm test",
    "timeoutMs": 600000
  },
  "requiredBuild": true,
  "runAllTests": true,
  "prePrCommand": "",
  "prePrInstructions": "",
  "reviewFixCommand": "",
  "maxPreemptions": 3,
  "memory": {
    "backends": {
      "wsMemo": true,
      "traps": true,
      "files": true
    }
  }
}
